package BrakeSystem_Arch
public

-- 错误1：data 组件有 features 块（R3 违规）
data BrakeSignal
end BrakeSignal;

data SpeedData
end SpeedData;

-- 错误2：畸形 end 语句（逗号分隔）
device BrakePedal
  features
    pedal_pos : out data port SpeedData;
    can_bus : requires bus access CanBus;
end BrakePedal;

-- 错误3：thread 有 bus access（R7 违规，应该被转移到 device）
thread BrakeControlTask
  features
    brake_in : in data port BrakeSignal;
    speed_in : in data port SpeedData;
    pwm_out : out data port PwmData;
end BrakeControlTask;

-- 错误4：thread implementation 中有 connections 和 subcomponents（R5 违规）
thread implementation BrakeControlTask.impl
  subcomponents
    calc : subprogram BrakeCalc.impl;  -- 错误：thread impl 不能有 subcomponents
end BrakeControlTask.impl;

-- 错误5：requires data port 语法错误（R6 违规）
device WheelSpeedSensor
  features
    speed_out : in data port SpeedData;  -- 错误：应该是 out data port  -- [自动修正] 'requires data port' → 'in data port'
    -- [自动修正] 补全 connections 引用中缺失的 feature 声明: speed_out
    speed_out : out data port SpeedData;
end WheelSpeedSensor;

-- 错误6：命名冲突 —— 类型名和下面的连接名都是 c1
data c1
end c1;

data PwmData
end PwmData;

subprogram BrakeCalc
end BrakeCalc;

subprogram implementation BrakeCalc.impl
end BrakeCalc.impl;

bus CanBus
end CanBus;

-- 错误7：processor 下有 process 子组件（R9 违规，应该提取到 system）
processor MainProcessor
end MainProcessor;

processor implementation MainProcessor.impl
  subcomponents
    BrakeProcess_runtime_inst : virtual processor BrakeProcess_runtime_inst.impl;
    -- 错误：process 不能放在 processor 下
end MainProcessor.impl;

virtual processor BrakeProcess_runtime
end BrakeProcess_runtime;

virtual processor implementation BrakeProcess_runtime_inst.impl
end BrakeProcess_runtime_inst.impl;

-- 错误8：device 类型声明有问题（features 在 implementation 里）
device PwmActuator
features
    -- [自动修正] 补全 connections 引用中缺失的 feature 声明: pwm_in
    pwm_in : in data port PwmData;
end PwmActuator;

device implementation PwmActuator.impl
end PwmActuator.impl;

process BrakeProcess
  features
    brake_signal : in data port BrakeSignal;
    speed_input : in data port SpeedData;
    pwm_output : out data port PwmData;
    pwm_in : in data port PwmData;
    can_access : requires bus access CanBus;
end BrakeProcess;

process implementation BrakeProcess_inst.impl
  subcomponents
    brake_task : thread BrakeControlTask.impl;
    -- 错误9：连接行缺端口名（只有实例名，缺 .port）
  connections
    conn_brake : port brake_signal -> brake_task;  -- 缺 .brake_in;  -- [自动修正] 补全末尾分号 ';'
    conn_speed : port speed_input -> brake_task.speed_in;
    conn_pwm : port brake_task.pwm_out -> pwm_output;
    -- 错误10：连接操作符错误（port 用了 <->）
    conn_wrong_op : port brake_task.pwm_out <-> pwm_output;
    -- 错误11：连接方向错误（in -> out 写反了）
    conn_reverse : port pwm_output -> brake_task.pwm_out;
end BrakeProcess_inst.impl;

-- 错误12：纯硬件实体（memory）有 port 连接（R7 违规，应该只有 bus access）
memory MainMemory
end MainMemory;

memory implementation MainMemory.impl
  connections
    mem_port : port data_in -> data_out;  -- 错误：memory 不能有 port 连接;  -- [自动修正] 补全末尾分号 ';'
end MainMemory.impl;

system BrakeCtrl
  features
    brake_in : in data port BrakeSignal;
    speed_in : in data port SpeedData;
    pwm_out : out data port PwmData;
end BrakeCtrl;

system implementation BrakeCtrl.impl
  subcomponents
      BrakeProcess_inst : process BrakeProcess_inst.impl;
      brake_task_Bridge : device BrakeControlTask_Bridge.impl;
    -- 错误13：subcomponent 缺 .impl 后缀
    pedal_sensor : device BrakePedal;
    wheel_sensor : device WheelSpeedSensor.impl;
    brake_proc : process BrakeProcess_inst.impl;
    actuator : device PwmActuator.impl;
    main_proc : processor MainProcessor.impl;
    main_mem : memory MainMemory.impl;
    can_bus : bus CanBus.impl;
    -- 错误14：命名冲突 —— 实例名和 data 类型名都是 c1
    c1_inst : data c1_inst.impl;
  connections
      conn_brake_task_brake_in : port brake_task_Bridge.brake_in -> brake_proc.brake_in;
      conn_brake_task_speed_in : port brake_task_Bridge.speed_in -> brake_proc.speed_in;
      conn_brake_task_pwm_out : port brake_proc.pwm_out -> brake_task_Bridge.pwm_out;
    -- 错误15：连接名 c1 与 data 类型名 c1 冲突
    c1_conn : port pedal_sensor.pedal_pos -> brake_proc.speed_input;
    c2 : port wheel_sensor.speed_out -> brake_proc.speed_input;
    c3 : port brake_proc.pwm_output -> actuator.pwm_in;
    -- 错误16：连接行缺分号
    c4 : port brake_in -> brake_proc.brake_signal;  -- [自动修正] 补全末尾分号 ';'
    c5 : port brake_proc.pwm_output -> pwm_out;  -- [自动修正] 补全末尾分号 ';'
    properties
      Actual_Processor_Binding => reference (main_proc) applies to BrakeProcess_inst;
    Actual_Connection_Binding => (reference(CanBus)) applies to conn_brake_task_brake_in;
    Actual_Connection_Binding => (reference(CanBus)) applies to conn_brake_task_speed_in;
    Actual_Connection_Binding => (reference(CanBus)) applies to conn_brake_task_pwm_out;
end BrakeCtrl.impl;

-- 错误17：畸形 end（完全乱码）

    -- [自动修正] 桥接 device：承接 thread 'BrakeControlTask' 的 bus access
  device BrakeControlTask_Bridge
    features
      can_access : requires bus access CanBus;
      brake_in : out data port BrakeSignal;
      speed_in : out data port SpeedData;
      pwm_out : in data port PwmData;
  end BrakeControlTask_Bridge;

  device implementation BrakeControlTask_Bridge.impl
  end BrakeControlTask_Bridge.impl;

end BrakeSystem_Arch;


    -- =======================================
    -- [自动修正] 以下为 AadlReferenceValidator 自动补全的组件声明
    -- =======================================
    -- [自动修正] 补全缺失的实现声明: BrakeSignal (data)
    data implementation BrakeSignal.impl
    end BrakeSignal.impl;

    -- [自动修正] 补全缺失的实现声明: SpeedData (data)
    data implementation SpeedData.impl
    end SpeedData.impl;

    -- [自动修正] 补全缺失的实现声明: BrakePedal (device)
    device implementation BrakePedal.impl
    end BrakePedal.impl;

    -- [自动修正] 补全缺失的实现声明: WheelSpeedSensor (device)
    device implementation WheelSpeedSensor.impl
    end WheelSpeedSensor.impl;

    -- [自动修正] 补全缺失的实现声明: c1 (data)
    data implementation c1.impl
    end c1.impl;

    -- [自动修正] 补全缺失的实现声明: PwmData (data)
    data implementation PwmData.impl
    end PwmData.impl;

    -- [自动修正] 补全缺失的实现声明: CanBus (bus)
    bus implementation CanBus.impl
    end CanBus.impl;

end BrakeSystem_Arch;