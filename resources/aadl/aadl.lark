// AS5506D (2022), clauses 4-15; Appendix C is informative.
// @trivia gap sep
// Shared CFG skeleton, cross-checked against OSATE b8308b7. Category legality,
// refinement compatibility, bounds, visibility and typing are AG obligations.
// No capture annotations, lookarounds, priorities or regex set operators:
// ordinary Lark Earley and llguidance 1.9.1 compile this same source.
start: gap aadl_specification
aadl_specification: (package_spec | property_set)+

// Clause 4.2: preserve public/private scopes and all library units in the tree.
package_spec: "package"i sep package_name sep (public_section private_section? | private_section) package_properties? "end"i sep end_package_name gap ";" gap
package_name: qualified_name
end_package_name: qualified_name
public_section: "public"i sep visibility_declaration* aadl_declaration*
private_section: "private"i sep visibility_declaration* aadl_declaration*
visibility_declaration: import_declaration | alias_declaration
import_declaration: "with"i sep import_name (gap "," gap import_name)* gap ";" gap
import_name: qualified_name
alias_declaration: package_alias | classifier_alias | wildcard_alias
package_alias: declaration_name sep "renames"i sep "package"i sep package_name gap ";" gap
classifier_alias: (declaration_name sep)? "renames"i sep (category | feature_group_category) sep classifier_reference gap ";" gap
wildcard_alias: "renames"i sep package_name gap "::" gap "all"i gap ";" gap
package_properties: "properties"i sep (property_association+ | none_statement)
aadl_declaration: component_type | component_implementation | feature_group_type | annex_library
none_statement: "none"i gap ";" gap

// Clauses 4.3-4.4: section order is grammatical; permitted members are typed by AG.
component_type: category sep declaration_name (type_extension | sep) type_body component_end
// A prototype-binding ')' is itself a lexical boundary; only an identifier
// ending the header needs a separator before the following keyword.
type_extension: sep "extends"i sep classifier_reference (prototype_bindings gap | sep)
type_body: prototypes? features? flow_specs? type_modes? properties? annex_subclause*
component_end: "end"i sep end_name gap ";" gap
component_implementation: category sep "implementation"i sep implementation_name (implementation_extension (prototype_bindings gap | sep) | prototype_bindings gap | sep) implementation_body implementation_end
implementation_extension: sep "extends"i sep classifier_reference
implementation_body: prototypes? subcomponents? internal_features? processor_features? calls? connections? flow_implementations? modes? properties? annex_subclause*
implementation_end: "end"i sep end_implementation_name gap ";" gap
implementation_name: declaration_name gap "." gap implementation_suffix
end_implementation_name: end_name gap "." gap implementation_suffix
implementation_suffix: identifier
declaration_name: identifier
end_name: identifier
category: "abstract"i | "data"i | "subprogram"i | "subprogram"i sep "group"i | "thread"i | "thread"i sep "group"i | "process"i | "processor"i | "virtual"i sep "processor"i | "memory"i | "bus"i | "virtual"i sep "bus"i | "device"i | "system"i
feature_group_category: "feature"i sep "group"i
refinement: "refined"i sep "to"i sep
classifier_reference: qualified_name (gap "." gap implementation_suffix)?
qualified_name: identifier (gap "::" gap identifier)*
identifier: IDENT

// Clauses 4.5 and 4.7: dimensions may be open or symbolic; bindings recurse.
subcomponents: "subcomponents"i sep (subcomponent+ | none_statement)
subcomponent: declaration_name gap ":" gap refinement? category (sep classifier_reference prototype_bindings?)? (array_dimensions array_implementations?)? inline_properties? (sep component_in_modes)? gap ";" gap
array_dimensions: array_dimension+
array_dimension: gap "[" gap array_dimension_size? gap "]"
array_dimension_size: NUMERAL | property_reference
array_implementations: gap "(" gap implementation_choice (gap "," gap implementation_choice)* gap ")"
implementation_choice: classifier_reference prototype_bindings?
array_selection: gap "[" gap selection_range gap "]"
selection_range: NUMERAL (gap ".." gap NUMERAL)?
prototypes: "prototypes"i sep (prototype+ | none_statement)
prototype: declaration_name gap ":" gap refinement? prototype_spec inline_properties? gap ";" gap
prototype_spec: component_prototype | feature_group_prototype | feature_prototype
component_prototype: category (sep classifier_reference)? prototype_array?
prototype_array: gap "[" gap "]"
feature_group_prototype: feature_group_category (sep classifier_reference)?
feature_prototype: (feature_direction sep)? "feature"i (sep classifier_reference)?
prototype_bindings: gap "(" gap prototype_binding (gap "," gap prototype_binding)* gap ")"
prototype_binding: prototype_name gap "=>" gap prototype_actual
prototype_name: identifier
prototype_actual: component_actual | component_actual_list | feature_group_actual | port_spec | access_spec | feature_prototype
component_actual: category sep classifier_reference prototype_bindings?
component_actual_list: "(" gap component_actual (gap "," gap component_actual)* gap ")"
feature_group_actual: feature_group_category sep classifier_reference prototype_bindings?

// Clause 8: a feature-group classifier is distinct from a feature of that type.
feature_group_type: feature_group_category sep declaration_name (type_extension | sep) prototypes? features? inverse_clause? properties? annex_subclause* component_end
inverse_clause: "inverse"i sep "of"i sep classifier_reference sep
features: "features"i sep (feature+ | none_statement)
feature: declaration_name gap ":" gap refinement? feature_spec array_dimension? inline_properties? gap ";" gap
feature_spec: port_spec | access_spec | parameter_spec | feature_group_spec | abstract_feature_spec
port_spec: direction sep (typed_port_kind (sep classifier_reference)? | event_port_kind)
typed_port_kind: "data"i sep "port"i | "event"i sep "data"i sep "port"i
event_port_kind: "event"i sep "port"i
direction: "in"i (sep "out"i)? | "out"i
feature_direction: "in"i | "out"i
access_direction: "requires"i | "provides"i
access_category: "data"i | "bus"i | "virtual"i sep "bus"i | "subprogram"i | "subprogram"i sep "group"i
access_spec: access_direction sep access_category sep "access"i (sep classifier_reference)?
parameter_spec: direction sep "parameter"i (sep classifier_reference)?
feature_group_spec: (feature_direction sep)? feature_group_category (sep inverse_marker? classifier_reference)?
inverse_marker: "inverse"i sep "of"i sep
abstract_feature_spec: (feature_direction sep)? ("feature"i (sep classifier_reference)? | "prototype"i sep classifier_reference)
internal_features: "internal"i sep "features"i sep internal_feature+
internal_feature: declaration_name gap ":" gap "event"i (sep "data"i (sep classifier_reference)?)? gap ";" gap
processor_features: "processor"i sep "features"i sep processor_feature+
processor_feature: declaration_name gap ":" gap ("port"i | "subprogram"i) (sep classifier_reference)? gap ";" gap

// Clauses 5.2 and 9: refinements omit endpoints; qualified references are
// resolved by attributes, not classified from the spelling of a.b.
calls: "calls"i sep (call_sequence+ | none_statement)
call_sequence: declaration_name gap ":" gap "{" gap subprogram_call+ "}" inline_properties? (gap in_modes)? gap ";" gap
subprogram_call: declaration_name gap ":" gap "subprogram"i sep called_subprogram inline_properties? gap ";" gap
called_subprogram: qualified_name (gap "." gap identifier)* | "processor"i gap "." gap identifier
connections: "connections"i sep (connection+ | none_statement)
connection: declaration_name gap ":" gap (connection_body | refinement connection_kind) (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap
connection_body: connection_kind sep source_endpoint gap connection_arrow gap destination_endpoint
connection_kind: "feature"i | "port"i | "parameter"i | (access_category sep)? "access"i | feature_group_category
connection_arrow: "->" | "<->"
source_endpoint: endpoint
destination_endpoint: endpoint
// Clause 9 connection references do not index arrays; indexing belongs to
// clause 11.3 contained model-element paths (e.g. property applies-to).
endpoint: endpoint_head (gap "." gap endpoint_segment)*
endpoint_head: identifier | "self"i | "processor"i
endpoint_segment: identifier

// Clause 10: specifications and implementation flow paths are separate nodes.
// Their graph continuity and endpoint kind restrictions are AG constraints.
flow_specs: "flows"i sep (flow_spec+ | none_statement)
flow_spec: declaration_name gap ":" gap (flow_spec_body | refinement "flow"i sep flow_kind) (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap
flow_spec_body: "flow"i sep ("source"i sep flow_endpoint | "sink"i sep flow_endpoint | "path"i sep flow_endpoint gap "->" gap flow_endpoint)
flow_kind: "source"i | "sink"i | "path"i
flow_endpoint: endpoint
flow_implementations: "flows"i sep ((flow_implementation | end_to_end_flow)+ | none_statement)
flow_implementation: flow_reference gap ":" gap "flow"i sep flow_kind sep flow_chain (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap
flow_reference: identifier
flow_chain: flow_segment (gap "->" gap flow_segment)*
flow_segment: endpoint
end_to_end_flow: declaration_name gap ":" gap refinement? "end"i sep "to"i sep "end"i sep "flow"i (sep flow_chain)? (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap

// Clause 11: scalar/record/list values, modal values, user types and units.
// An association's applicability and whether its value is constant are AG rules.
properties: "properties"i sep (property_association+ | none_statement)
inline_properties: gap "{" gap property_association+ "}"
property_association: property_name gap assignment_operator gap constant_marker? (word_assignment (sep (word_applies_to (sep in_binding)? | delimited_applies_to (gap in_binding)? | in_binding))? | delimited_assignment (gap (word_applies_to (sep in_binding)? | delimited_applies_to (gap in_binding)? | in_binding))?) gap ";" gap
property_name: qualified_name
assignment_operator: "=>" | "+=>"
constant_marker: "constant"i sep
assignment: modal_value (gap "," gap modal_value)*
modal_value: word_value (sep in_modes)? | delimited_value (gap in_modes)?
property_value: property_expression | list_value
property_expression: range_expression | numeric_value | string_literal | boolean_literal | property_reference | signed_property_reference | classifier_term | reference_term | record_value | computed_term
signed_property_reference: sign property_reference
list_value: "(" gap (property_value (gap "," gap property_value)*)? gap ")"
numeric_value: sign? number (sep unit_name)?
numeric_term: numeric_value | sign? property_reference
range_expression: numeric_term gap ".." gap numeric_term (sep "delta"i sep numeric_term)?
number: REAL | BASED_INTEGER | DECIMAL_INTEGER
sign: ("+" | "-") gap
unit_name: identifier
string_literal: STRING
boolean_literal: "true"i | "false"i
property_reference: qualified_name
classifier_term: "classifier"i gap "(" gap classifier_reference gap ")"
reference_term: "reference"i gap "(" gap contained_path gap ")"
computed_term: "compute"i gap "(" gap function_name gap ")"
function_name: identifier
record_value: "[" gap record_assignment+ "]"
record_assignment: declaration_name gap "=>" gap property_value gap ";" gap
applies_to: "applies"i sep "to"i sep contained_path (gap "," gap contained_path)*
contained_path: endpoint_head array_selection* (gap "." gap contained_path_segment)*
contained_path_segment: identifier array_selection*
in_binding: "in"i sep "binding"i gap "(" gap classifier_reference (gap "," gap classifier_reference)* gap ")"

property_set: "property"i sep "set"i sep declaration_name sep "is"i sep import_declaration* (property_type_declaration | property_definition | property_constant)* annex_subclause* "end"i sep end_name gap ";" gap
property_type_declaration: declaration_name gap ":" gap "type"i sep property_type gap ";" gap
property_definition: declaration_name gap ":" gap inherit_marker? (word_type_designator sep | delimited_type_designator gap | property_type_designator gap "=>" gap (word_value sep | delimited_value gap)) "applies"i sep "to"i gap "(" gap property_owner (gap "," gap property_owner)* gap ")" gap ";" gap
inherit_marker: "inherit"i sep
property_constant: declaration_name gap ":" gap "constant"i sep property_type_designator gap "=>" gap property_value gap ";" gap
property_type_designator: list_type | property_type | property_reference
list_type: "list"i sep "of"i sep property_type_designator
property_type: "aadlboolean"i | "aadlstring"i | enumeration_type | units_type | number_type | range_type | classifier_type | reference_type | record_type
enumeration_type: "enumeration"i gap "(" gap declaration_name (gap "," gap declaration_name)* gap ")"
units_type: "units"i gap units_list
units_list: "(" gap unit_declaration (gap "," gap unit_conversion)* gap ")"
unit_declaration: declaration_name
unit_conversion: declaration_name gap "=>" gap unit_name gap "*" gap numeric_value
number_type: ("aadlinteger"i | "aadlreal"i) (sep type_range)? (sep "units"i gap units_designator)?
type_range: numeric_term gap ".." gap numeric_term
units_designator: property_reference | units_list
range_type: "range"i sep "of"i sep (number_type | property_reference)
classifier_type: "classifier"i (gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")")?
reference_type: "reference"i (gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")")?
record_type: "record"i gap "(" gap record_field+ ")"
record_field: declaration_name gap ":" gap property_type_designator gap ";" gap
// Clause 11.1: a classifier owner is qualified by its package. Without this
// distinction an unqualified meta-class such as connection has two parse trees.
property_owner: "all"i | qualified_classifier_owner | metaclass_reference
qualified_classifier_owner: package_name gap "::" gap identifier
metaclass_reference: annex_metaclass? metaclass_word (sep metaclass_word)*
annex_metaclass: "{" gap identifier gap "}" gap "**" gap
metaclass_word: META_WORD

// Clause 15.2(4): a word-ending value/type needs a separator before
// applies/in; a value/type ending in ], ), or a string quote does not.
// The branches are disjoint by their final lexical category. Aliases preserve
// the ordinary semantic node names without an extra value or assignment node.
word_value: word_expression -> property_value
delimited_value: delimited_expression -> property_value
               | list_value -> property_value
word_expression: (range_expression | numeric_value | boolean_literal | property_reference | signed_property_reference) -> property_expression
delimited_expression: (string_literal | classifier_term | reference_term | record_value | computed_term) -> property_expression
word_modal_value: word_value -> modal_value
delimited_modal_value: delimited_value -> modal_value
                     | word_value sep in_modes -> modal_value
                     | delimited_value gap in_modes -> modal_value
word_assignment: (modal_value gap "," gap)* word_modal_value -> assignment
delimited_assignment: (modal_value gap "," gap)* delimited_modal_value -> assignment

// Array selection ends with ], so a subsequent in binding needs only gap.
word_path_segment: identifier -> contained_path_segment
delimited_path_segment: identifier array_selection+ -> contained_path_segment
word_contained_path: endpoint_head -> contained_path
                   | endpoint_head array_selection* (gap "." gap contained_path_segment)* gap "." gap word_path_segment -> contained_path
delimited_contained_path: endpoint_head array_selection+ -> contained_path
                        | endpoint_head array_selection* (gap "." gap contained_path_segment)* gap "." gap delimited_path_segment -> contained_path
word_applies_to: "applies"i sep "to"i sep (contained_path gap "," gap)* word_contained_path -> applies_to
delimited_applies_to: "applies"i sep "to"i sep (contained_path gap "," gap)* delimited_contained_path -> applies_to

word_type_designator: word_list_type -> property_type_designator
                    | word_property_type -> property_type_designator
                    | property_reference -> property_type_designator
delimited_type_designator: delimited_list_type -> property_type_designator
                         | delimited_property_type -> property_type_designator
word_list_type: "list"i sep "of"i sep word_type_designator -> list_type
delimited_list_type: "list"i sep "of"i sep delimited_type_designator -> list_type
word_property_type: "aadlboolean"i -> property_type
                  | "aadlstring"i -> property_type
                  | word_number_type -> property_type
                  | word_range_type -> property_type
                  | word_classifier_type -> property_type
                  | word_reference_type -> property_type
delimited_property_type: enumeration_type -> property_type
                       | units_type -> property_type
                       | delimited_number_type -> property_type
                       | delimited_range_type -> property_type
                       | delimited_classifier_type -> property_type
                       | delimited_reference_type -> property_type
                       | record_type -> property_type
word_number_type: ("aadlinteger"i | "aadlreal"i) (sep type_range)? (sep "units"i sep property_reference)? -> number_type
delimited_number_type: ("aadlinteger"i | "aadlreal"i) (sep type_range)? sep "units"i gap units_list -> number_type
word_range_type: "range"i sep "of"i sep (word_number_type | property_reference) -> range_type
delimited_range_type: "range"i sep "of"i sep delimited_number_type -> range_type
word_classifier_type: "classifier"i -> classifier_type
delimited_classifier_type: "classifier"i gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")" -> classifier_type
word_reference_type: "reference"i -> reference_type
delimited_reference_type: "reference"i gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")" -> reference_type

// Clause 12: mode transitions use indivisible -[ and ]-> delimiters.
type_modes: modes | requires_modes
modes: "modes"i sep ((mode | mode_transition)+ | none_statement)
requires_modes: "requires"i sep "modes"i sep (mode+ | none_statement)
mode: declaration_name gap ":" gap initial_marker? "mode"i inline_properties? gap ";" gap
initial_marker: "initial"i sep
mode_transition: (declaration_name gap ":" gap)? mode_reference gap "-[" gap mode_trigger (gap "," gap mode_trigger)* gap "]->" gap mode_reference inline_properties? gap ";" gap
mode_reference: identifier
mode_trigger: endpoint
in_modes: "in"i sep "modes"i gap "(" gap mode_reference (gap "," gap mode_reference)* gap ")"
component_in_modes: "in"i sep "modes"i gap "(" gap mode_binding (gap "," gap mode_binding)* gap ")"
mode_binding: mode_reference (gap "=>" gap mode_reference)?

// Clause 4.8(7)-(8): accept annex containers; their bodies are deliberately
// opaque. The forbidden internal symbol **} closes the first such container.
annex_library: "annex"i sep annex_name annex_body gap ";" gap
annex_subclause: "annex"i sep annex_name annex_body (gap in_modes)? gap ";" gap
annex_name: identifier
// The opening annex delimiter needs no separator; the word none still does.
annex_body: gap ANNEX_TEXT | sep "none"i

// Clause 15: explicit sep prevents missing word/number boundaries (8Bytes).
// LINE_COMMENT is also a gap alternative: optional units must survive a
// comment followed by a line break, rather than taking a different lexer path.
gap: (WS | LINE_COMMENT | COMMENT)*
sep: (WS | LINE_COMMENT)+
WS: /[ \t\v\f\r\n]+/
LINE_COMMENT: /--[^\v\f\r\n]*[\v\f\r\n]/
COMMENT: /--[^\v\f\r\n]*/
NUMERAL: /[0-9](?:_?[0-9])*/
DECIMAL_INTEGER: /[0-9](?:_?[0-9])*(?:[Ee]\+?[0-9](?:_?[0-9])*)?/
REAL: /[0-9](?:_?[0-9])*\.[0-9](?:_?[0-9])*(?:[Ee][+-]?[0-9](?:_?[0-9])*)?/
BASED_INTEGER: /[0-9]{1,2}#[0-9A-Fa-f](?:_?[0-9A-Fa-f])*#(?:[Ee]\+?[0-9](?:_?[0-9])*)?/
STRING: /"(?:\"\"|[\u0020-\u0021\u0023-\u007e\u00a0-\ud7ff\ue000-\ufffd])*"/
ANNEX_TEXT: /\{\*\*(?:[^*]|\*[^*]|\*{2,}[^*}])*\*{2,}\}/
// META_WORD permits reserved words in meta-model names such as thread group.
META_WORD: /[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff](?:_?[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff0-9])*/
// Portable finite-word exclusion is generated from the clause-15 reserved list;
// unlike lookaround or &/~ this is accepted by both regex implementations.
IDENT: /(?:(?:[hj-kqx-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|a(?:[d-kmoq-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|a(?:[a-ce-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|d(?:[a-km-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|l(?:[ac-hj-qt-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|b(?:[a-np-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|o(?:[a-np-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|o(?:[a-km-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|l(?:[a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|e(?:[b-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|a(?:[a-mo-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|n(?:[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff])))))))|i(?:[a-mo-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|n(?:[a-su-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|t(?:[a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|e(?:[a-fh-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|g(?:[a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|e(?:[a-qs-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|r(?:[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff])))))))|r(?:[a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff