// AS5506D (2022), clauses 4-15; Appendix C is informative.
// @trivia gap sep
// Shared CFG skeleton, cross-checked against OSATE b8308b7. Category legality,
// refinement compatibility, bounds, visibility and typing are AG obligations.
// ASCII keyword case is explicit: Unicode ignore-case would also accept
// long s (U+017F), Kelvin sign (U+212A), and dotted/dotless I spellings.
// Identifiers retain the Latin-1 letter repertoire specified by clause 15.1.
// No capture annotations, lookarounds, priorities or regex set operators:
// ordinary Lark Earley and llguidance 1.9.1 compile this same source.
start: gap aadl_specification
// OSATE file compatibility profile: each FILE contains one model unit. This
// is a selected tool/file boundary, not a claim that an entire AADL project
// contains only one package. Cross-file names still share the project scope.
aadl_specification: package_spec | property_set

// Clause 4.2: preserve public/private scopes and all library units in the tree.
package_spec: /[pP][aA][cC][kK][aA][gG][eE]/ sep package_name sep (public_section private_section? | private_section) package_properties? /[eE][nN][dD]/ sep end_package_name gap ";" gap
package_name: qualified_name
end_package_name: qualified_name
public_section: /[pP][uU][bB][lL][iI][cC]/ sep visibility_declaration* aadl_declaration*
private_section: /[pP][rR][iI][vV][aA][tT][eE]/ sep visibility_declaration* aadl_declaration*
visibility_declaration: import_declaration | alias_declaration
import_declaration: /[wW][iI][tT][hH]/ sep import_name (gap "," gap import_name)* gap ";" gap
import_name: qualified_name
alias_declaration: package_alias | classifier_alias | wildcard_alias
package_alias: declaration_name sep /[rR][eE][nN][aA][mM][eE][sS]/ sep /[pP][aA][cC][kK][aA][gG][eE]/ sep package_name gap ";" gap
classifier_alias: (declaration_name sep)? /[rR][eE][nN][aA][mM][eE][sS]/ sep (category | feature_group_category) sep classifier_reference gap ";" gap
wildcard_alias: /[rR][eE][nN][aA][mM][eE][sS]/ sep package_name gap "::" gap /[aA][lL][lL]/ gap ";" gap
package_properties: /[pP][rR][oO][pP][eE][rR][tT][iI][eE][sS]/ sep (property_association+ | none_statement)
aadl_declaration: component_type | component_implementation | feature_group_type | annex_library
none_statement: /[nN][oO][nN][eE]/ gap ";" gap

// Clauses 4.3-4.4: section order is grammatical; permitted members are typed by AG.
component_type: category sep declaration_name (type_extension | sep) type_body component_end
// A prototype-binding ')' is itself a lexical boundary; only an identifier
// ending the header needs a separator before the following keyword.
type_extension: sep /[eE][xX][tT][eE][nN][dD][sS]/ sep classifier_reference (prototype_bindings gap | sep)
type_body: prototypes? features? flow_specs? type_modes? properties? annex_subclause*
component_end: /[eE][nN][dD]/ sep end_name gap ";" gap
component_implementation: category sep /[iI][mM][pP][lL][eE][mM][eE][nN][tT][aA][tT][iI][oO][nN]/ sep implementation_name (implementation_extension (prototype_bindings gap | sep) | prototype_bindings gap | sep) implementation_body implementation_end
implementation_extension: sep /[eE][xX][tT][eE][nN][dD][sS]/ sep classifier_reference
implementation_body: prototypes? subcomponents? internal_features? processor_features? calls? connections? flow_implementations? modes? properties? annex_subclause*
implementation_end: /[eE][nN][dD]/ sep end_implementation_name gap ";" gap
implementation_name: declaration_name gap "." gap implementation_suffix
end_implementation_name: end_name gap "." gap implementation_suffix
implementation_suffix: identifier
declaration_name: identifier
end_name: identifier
category: /[aA][bB][sS][tT][rR][aA][cC][tT]/ | /[dD][aA][tT][aA]/ | /[sS][uU][bB][pP][rR][oO][gG][rR][aA][mM]/ | /[sS][uU][bB][pP][rR][oO][gG][rR][aA][mM]/ sep /[gG][rR][oO][uU][pP]/ | /[tT][hH][rR][eE][aA][dD]/ | /[tT][hH][rR][eE][aA][dD]/ sep /[gG][rR][oO][uU][pP]/ | /[pP][rR][oO][cC][eE][sS][sS]/ | /[pP][rR][oO][cC][eE][sS][sS][oO][rR]/ | /[vV][iI][rR][tT][uU][aA][lL]/ sep /[pP][rR][oO][cC][eE][sS][sS][oO][rR]/ | /[mM][eE][mM][oO][rR][yY]/ | /[bB][uU][sS]/ | /[vV][iI][rR][tT][uU][aA][lL]/ sep /[bB][uU][sS]/ | /[dD][eE][vV][iI][cC][eE]/ | /[sS][yY][sS][tT][eE][mM]/
feature_group_category: /[fF][eE][aA][tT][uU][rR][eE]/ sep /[gG][rR][oO][uU][pP]/
refinement: /[rR][eE][fF][iI][nN][eE][dD]/ sep /[tT][oO]/ sep
classifier_reference: qualified_name (gap "." gap implementation_suffix)?
qualified_name: identifier (gap "::" gap identifier)*
// Share the contextual keyword terminal with identifier, so both parsers
// use the same token instead of competing overlapping lexer patterns.
identifier: IDENT | /[iI][nN][tT][eE][rR][nN][aA][lL]/

// Clauses 4.5 and 4.7: dimensions may be open or symbolic; bindings recurse.
subcomponents: /[sS][uU][bB][cC][oO][mM][pP][oO][nN][eE][nN][tT][sS]/ sep (subcomponent+ | none_statement)
// Clause 15.2(4): a closing ], ), or } already separates a following in.
// Keep word-ending and delimiter-ending tails disjoint, without wrapping
// semantic fields in a helper node or allowing a missing word separator.
subcomponent: declaration_name gap ":" gap refinement? category ((sep classifier_reference)? (array_dimensions array_implementations? inline_properties? (gap component_in_modes)? | inline_properties (gap component_in_modes)? | (sep component_in_modes)?) | sep classifier_reference prototype_bindings (array_dimensions array_implementations?)? inline_properties? (gap component_in_modes)?) gap ";" gap
array_dimensions: array_dimension+
array_dimension: gap "[" gap array_dimension_size? gap "]"
array_dimension_size: NUMERAL | property_reference
array_implementations: gap "(" gap implementation_choice (gap "," gap implementation_choice)* gap ")"
implementation_choice: classifier_reference prototype_bindings?
array_selection: gap "[" gap selection_range gap "]"
selection_range: NUMERAL (gap ".." gap NUMERAL)?
prototypes: /[pP][rR][oO][tT][oO][tT][yY][pP][eE][sS]/ sep (prototype+ | none_statement)
prototype: declaration_name gap ":" gap refinement? prototype_spec inline_properties? gap ";" gap
prototype_spec: component_prototype | feature_group_prototype | feature_prototype
component_prototype: category (sep classifier_reference)? prototype_array?
prototype_array: gap "[" gap "]"
feature_group_prototype: feature_group_category (sep classifier_reference)?
feature_prototype: (feature_direction sep)? /[fF][eE][aA][tT][uU][rR][eE]/ (sep classifier_reference)?
prototype_bindings: gap "(" gap prototype_binding (gap "," gap prototype_binding)* gap ")"
prototype_binding: prototype_name gap "=>" gap prototype_actual
prototype_name: identifier
prototype_actual: component_actual | component_actual_list | feature_group_actual | port_spec | access_spec | feature_prototype
component_actual: category sep classifier_reference prototype_bindings?
component_actual_list: "(" gap component_actual (gap "," gap component_actual)* gap ")"
feature_group_actual: feature_group_category sep classifier_reference prototype_bindings?

// Clause 8: a feature-group classifier is distinct from a feature of that type.
feature_group_type: feature_group_category sep declaration_name (type_extension | sep) prototypes? features? inverse_clause? properties? annex_subclause* component_end
inverse_clause: /[iI][nN][vV][eE][rR][sS][eE]/ sep /[oO][fF]/ sep classifier_reference sep
features: /[fF][eE][aA][tT][uU][rR][eE][sS]/ sep (feature+ | none_statement)
feature: declaration_name gap ":" gap refinement? feature_spec array_dimension? inline_properties? gap ";" gap
feature_spec: port_spec | access_spec | parameter_spec | feature_group_spec | abstract_feature_spec
port_spec: direction sep (typed_port_kind (sep classifier_reference)? | event_port_kind)
typed_port_kind: /[dD][aA][tT][aA]/ sep /[pP][oO][rR][tT]/ | /[eE][vV][eE][nN][tT]/ sep /[dD][aA][tT][aA]/ sep /[pP][oO][rR][tT]/
event_port_kind: /[eE][vV][eE][nN][tT]/ sep /[pP][oO][rR][tT]/
direction: /[iI][nN]/ (sep /[oO][uU][tT]/)? | /[oO][uU][tT]/
feature_direction: /[iI][nN]/ | /[oO][uU][tT]/
access_direction: /[rR][eE][qQ][uU][iI][rR][eE][sS]/ | /[pP][rR][oO][vV][iI][dD][eE][sS]/
access_category: /[dD][aA][tT][aA]/ | /[bB][uU][sS]/ | /[vV][iI][rR][tT][uU][aA][lL]/ sep /[bB][uU][sS]/ | /[sS][uU][bB][pP][rR][oO][gG][rR][aA][mM]/ | /[sS][uU][bB][pP][rR][oO][gG][rR][aA][mM]/ sep /[gG][rR][oO][uU][pP]/
access_spec: access_direction sep access_category sep /[aA][cC][cC][eE][sS][sS]/ (sep classifier_reference)?
parameter_spec: direction sep /[pP][aA][rR][aA][mM][eE][tT][eE][rR]/ (sep classifier_reference)?
feature_group_spec: (feature_direction sep)? feature_group_category (sep inverse_marker? classifier_reference)?
inverse_marker: /[iI][nN][vV][eE][rR][sS][eE]/ sep /[oO][fF]/ sep
abstract_feature_spec: (feature_direction sep)? (/[fF][eE][aA][tT][uU][rR][eE]/ (sep classifier_reference)? | /[pP][rR][oO][tT][oO][tT][yY][pP][eE]/ sep classifier_reference)
internal_features: /[iI][nN][tT][eE][rR][nN][aA][lL]/ sep /[fF][eE][aA][tT][uU][rR][eE][sS]/ sep internal_feature+
internal_feature: declaration_name gap ":" gap /[eE][vV][eE][nN][tT]/ (sep /[dD][aA][tT][aA]/ (sep classifier_reference)?)? gap ";" gap
processor_features: /[pP][rR][oO][cC][eE][sS][sS][oO][rR]/ sep /[fF][eE][aA][tT][uU][rR][eE][sS]/ sep processor_feature+
processor_feature: declaration_name gap ":" gap (/[pP][oO][rR][tT]/ | /[sS][uU][bB][pP][rR][oO][gG][rR][aA][mM]/) (sep classifier_reference)? gap ";" gap

// Clauses 5.2 and 9: refinements omit endpoints; qualified references are
// resolved by attributes, not classified from the spelling of a.b.
calls: /[cC][aA][lL][lL][sS]/ sep (call_sequence+ | none_statement)
call_sequence: declaration_name gap ":" gap "{" gap subprogram_call+ "}" inline_properties? (gap in_modes)? gap ";" gap
subprogram_call: declaration_name gap ":" gap /[sS][uU][bB][pP][rR][oO][gG][rR][aA][mM]/ sep called_subprogram inline_properties? gap ";" gap
called_subprogram: qualified_name (gap "." gap identifier)* | /[pP][rR][oO][cC][eE][sS][sS][oO][rR]/ gap "." gap identifier
connections: /[cC][oO][nN][nN][eE][cC][tT][iI][oO][nN][sS]/ sep (connection+ | none_statement)
connection: declaration_name gap ":" gap (connection_body | refinement connection_kind) (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap
connection_body: connection_kind sep source_endpoint gap connection_arrow gap destination_endpoint
connection_kind: /[fF][eE][aA][tT][uU][rR][eE]/ | /[pP][oO][rR][tT]/ | /[pP][aA][rR][aA][mM][eE][tT][eE][rR]/ | (access_category sep)? /[aA][cC][cC][eE][sS][sS]/ | feature_group_category
connection_arrow: "->" | "<->"
source_endpoint: endpoint
destination_endpoint: endpoint
// Clause 9 connection references do not index arrays; indexing belongs to
// clause 11.3 contained model-element paths (e.g. property applies-to).
endpoint: endpoint_head (gap "." gap endpoint_segment)*
endpoint_head: identifier | /[sS][eE][lL][fF]/ | /[pP][rR][oO][cC][eE][sS][sS][oO][rR]/
endpoint_segment: identifier

// Clause 10: specifications and implementation flow paths are separate nodes.
// Their graph continuity and endpoint kind restrictions are AG constraints.
flow_specs: /[fF][lL][oO][wW][sS]/ sep (flow_spec+ | none_statement)
flow_spec: declaration_name gap ":" gap (flow_spec_body | refinement /[fF][lL][oO][wW]/ sep flow_kind) (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap
flow_spec_body: /[fF][lL][oO][wW]/ sep (/[sS][oO][uU][rR][cC][eE]/ sep flow_endpoint | /[sS][iI][nN][kK]/ sep flow_endpoint | /[pP][aA][tT][hH]/ sep flow_endpoint gap "->" gap flow_endpoint)
flow_kind: /[sS][oO][uU][rR][cC][eE]/ | /[sS][iI][nN][kK]/ | /[pP][aA][tT][hH]/
flow_endpoint: endpoint
flow_implementations: /[fF][lL][oO][wW][sS]/ sep ((flow_implementation | end_to_end_flow)+ | none_statement)
flow_implementation: flow_reference gap ":" gap /[fF][lL][oO][wW]/ sep flow_kind sep flow_chain (inline_properties (gap in_modes)? | sep in_modes)? gap ";" gap
flow_reference: identifier
flow_chain: flow_segment (gap "->" gap flow_segment)*
flow_segment: endpoint
// Clause 10.3: a specification has two endpoints; an implementation adds
// connection/flow pairs. A refinement must actually supply properties or modes.
// Aliases keep both forms bound to the same flow_chain semantic attribute.
end_to_end_flow: declaration_name gap ":" gap (/[eE][nN][dD]/ sep /[tT][oO]/ sep /[eE][nN][dD]/ sep /[fF][lL][oO][wW]/ sep end_to_end_chain (inline_properties (gap in_modes)? | sep in_modes)? | refinement /[eE][nN][dD]/ sep /[tT][oO]/ sep /[eE][nN][dD]/ sep /[fF][lL][oO][wW]/ (sep end_to_end_refinement_chain)? (inline_properties (gap in_modes)? | sep in_modes)) gap ";" gap
end_to_end_chain: flow_segment gap "->" gap flow_segment -> flow_chain
               | flow_segment (gap "->" gap flow_segment gap "->" gap flow_segment)+ -> flow_chain
end_to_end_refinement_chain: flow_segment (gap "->" gap flow_segment gap "->" gap flow_segment)+ -> flow_chain

// Clause 11: scalar/record/list values, modal values, user types and units.
// An association's applicability and whether its value is constant are AG rules.
properties: /[pP][rR][oO][pP][eE][rR][tT][iI][eE][sS]/ sep (property_association+ | none_statement)
inline_properties: gap "{" gap property_association+ "}"
property_association: property_name gap assignment_operator gap (constant_marker? (word_assignment (sep (word_applies_to (sep in_binding)? | delimited_applies_to (gap in_binding)? | in_binding))? | delimited_assignment (gap (word_applies_to (sep in_binding)? | delimited_applies_to (gap in_binding)? | in_binding))?) | adjacent_constant_marker (adjacent_word_assignment (sep (word_applies_to (sep in_binding)? | delimited_applies_to (gap in_binding)? | in_binding))? | adjacent_delimited_assignment (gap (word_applies_to (sep in_binding)? | delimited_applies_to (gap in_binding)? | in_binding))?)) gap ";" gap
property_name: qualified_name
assignment_operator: "=>" | "+=>"
constant_marker: /[cC][oO][nN][sS][tT][aA][nN][tT]/ sep
// Clause 15.2 permits constant+1, constant"text", constant(...), and
// constant[...] without whitespace. Keep this adjacent branch disjoint from
// constant_marker's whitespace branch; constant1 remains a reference name.
adjacent_constant_marker: /[cC][oO][nN][sS][tT][aA][nN][tT]/ -> constant_marker
adjacent_signed_range: signed_numeric_term gap ".." gap numeric_term (sep /[dD][eE][lL][tT][aA]/ (sep word_numeric_term | gap signed_numeric_term))? -> range_expression
adjacent_signed_expression: (adjacent_signed_range | signed_numeric_value | signed_property_reference) -> property_expression
adjacent_bracket_expression: (string_literal | record_value) -> property_expression
adjacent_word_value: adjacent_signed_expression -> property_value
adjacent_delimited_value: adjacent_bracket_expression -> property_value
                        | list_value -> property_value
adjacent_modal_value: adjacent_word_value sep in_modes -> modal_value
                   | adjacent_delimited_value gap in_modes -> modal_value
adjacent_word_modal_value: adjacent_word_value -> modal_value
adjacent_delimited_modal_value: adjacent_delimited_value -> modal_value
                             | adjacent_word_value sep in_modes -> modal_value
                             | adjacent_delimited_value gap in_modes -> modal_value
adjacent_word_assignment: adjacent_word_modal_value -> assignment
                       | adjacent_modal_value gap "," gap (modal_value gap "," gap)* word_modal_value -> assignment
adjacent_delimited_assignment: adjacent_delimited_modal_value -> assignment
                            | adjacent_modal_value gap "," gap (modal_value gap "," gap)* delimited_modal_value -> assignment
assignment: modal_value (gap "," gap modal_value)*
// Clause 11.3: only a modal value may precede a comma. A single
// unqualified default remains legal as the final value through the aliases.
modal_value: word_value sep in_modes | delimited_value gap in_modes
property_value: property_expression | list_value
property_expression: range_expression | numeric_value | string_literal | boolean_literal | property_reference | signed_property_reference | classifier_term | reference_term | record_value | computed_term
signed_property_reference: sign property_reference
list_value: "(" gap (property_value (gap "," gap property_value)*)? gap ")"
numeric_value: sign? number (sep unit_name)?
numeric_term: numeric_value | sign? property_reference
// A sign is a delimiter: aadlinteger-1 and delta+1 need no extra space.
// Aliases preserve the value/term/range nodes consumed by Python attributes.
word_numeric_value: number (sep unit_name)? -> numeric_value
signed_numeric_value: sign number (sep unit_name)? -> numeric_value
word_numeric_term: word_numeric_value -> numeric_term
                 | property_reference -> numeric_term
signed_numeric_term: signed_numeric_value -> numeric_term
                   | sign property_reference -> numeric_term
word_type_range: word_numeric_term gap ".." gap numeric_term -> type_range
signed_type_range: signed_numeric_term gap ".." gap numeric_term -> type_range
range_expression: numeric_term gap ".." gap numeric_term (sep /[dD][eE][lL][tT][aA]/ (sep word_numeric_term | gap signed_numeric_term))?
// Decompose decimal literals so the shared lexer can distinguish 1..2 from
// a real literal. A monolithic REAL regexp greedily commits after the first
// dot in llguidance, incorrectly rejecting the standard range delimiter.
number: NUMERAL "." NUMERAL EXPONENT? | BASED_INTEGER | NUMERAL POSITIVE_EXPONENT?
sign: ("+" | "-") gap
unit_name: identifier
string_literal: STRING
boolean_literal: /[tT][rR][uU][eE]/ | /[fF][aA][lL][sS][eE]/
property_reference: qualified_name
classifier_term: /[cC][lL][aA][sS][sS][iI][fF][iI][eE][rR]/ gap "(" gap classifier_reference gap ")"
reference_term: /[rR][eE][fF][eE][rR][eE][nN][cC][eE]/ gap "(" gap contained_path gap ")"
computed_term: /[cC][oO][mM][pP][uU][tT][eE]/ gap "(" gap function_name gap ")"
function_name: identifier
record_value: "[" gap record_assignment+ "]"
record_assignment: declaration_name gap "=>" gap property_value gap ";" gap
applies_to: /[aA][pP][pP][lL][iI][eE][sS]/ sep /[tT][oO]/ sep contained_path (gap "," gap contained_path)*
contained_path: endpoint_head array_selection* (gap "." gap contained_path_segment)*
contained_path_segment: identifier array_selection*
in_binding: /[iI][nN]/ sep /[bB][iI][nN][dD][iI][nN][gG]/ gap "(" gap classifier_reference (gap "," gap classifier_reference)* gap ")"

property_set: /[pP][rR][oO][pP][eE][rR][tT][yY]/ sep /[sS][eE][tT]/ sep declaration_name sep /[iI][sS]/ sep import_declaration* (property_type_declaration | property_definition | property_constant)* annex_subclause* /[eE][nN][dD]/ sep end_name gap ";" gap
property_type_declaration: declaration_name gap ":" gap /[tT][yY][pP][eE]/ sep property_type gap ";" gap
property_definition: declaration_name gap ":" gap inherit_marker? (word_type_designator sep | delimited_type_designator gap | property_type_designator gap "=>" gap (word_value sep | delimited_value gap)) /[aA][pP][pP][lL][iI][eE][sS]/ sep /[tT][oO]/ gap "(" gap property_owner (gap "," gap property_owner)* gap ")" gap ";" gap
inherit_marker: /[iI][nN][hH][eE][rR][iI][tT]/ sep
property_constant: declaration_name gap ":" gap /[cC][oO][nN][sS][tT][aA][nN][tT]/ sep property_type_designator gap "=>" gap property_value gap ";" gap
property_type_designator: list_type | property_type | property_reference
list_type: /[lL][iI][sS][tT]/ sep /[oO][fF]/ sep property_type_designator
property_type: /[aA][aA][dD][lL][bB][oO][oO][lL][eE][aA][nN]/ | /[aA][aA][dD][lL][sS][tT][rR][iI][nN][gG]/ | enumeration_type | units_type | number_type | range_type | classifier_type | reference_type | record_type
enumeration_type: /[eE][nN][uU][mM][eE][rR][aA][tT][iI][oO][nN]/ gap "(" gap declaration_name (gap "," gap declaration_name)* gap ")"
units_type: /[uU][nN][iI][tT][sS]/ gap units_list
units_list: "(" gap unit_declaration (gap "," gap unit_conversion)* gap ")"
unit_declaration: declaration_name
unit_conversion: declaration_name gap "=>" gap unit_name gap "*" gap numeric_value
number_type: (/[aA][aA][dD][lL][iI][nN][tT][eE][gG][eE][rR]/ | /[aA][aA][dD][lL][rR][eE][aA][lL]/) (sep word_type_range | gap signed_type_range)? (sep /[uU][nN][iI][tT][sS]/ gap units_designator)?
type_range: numeric_term gap ".." gap numeric_term
units_designator: property_reference | units_list
range_type: /[rR][aA][nN][gG][eE]/ sep /[oO][fF]/ sep (number_type | property_reference)
classifier_type: /[cC][lL][aA][sS][sS][iI][fF][iI][eE][rR]/ (gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")")?
reference_type: /[rR][eE][fF][eE][rR][eE][nN][cC][eE]/ (gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")")?
record_type: /[rR][eE][cC][oO][rR][dD]/ gap "(" gap record_field+ ")"
record_field: declaration_name gap ":" gap property_type_designator gap ";" gap
// Clause 11.1: a classifier owner is qualified by its package. Without this
// distinction an unqualified meta-class such as connection has two parse trees.
property_owner: /[aA][lL][lL]/ | qualified_classifier_owner | metaclass_reference
qualified_classifier_owner: package_name gap "::" gap identifier
metaclass_reference: annex_metaclass? metaclass_word (sep metaclass_word)*
annex_metaclass: "{" gap identifier gap "}" gap "**" gap
metaclass_word: META_WORD

// Clause 15.2(4): a word-ending value/type needs a separator before
// applies/in; a value/type ending in ], ), or a string quote does not.
// The branches are disjoint by their final lexical category. Aliases preserve
// the ordinary semantic node names without an extra value or assignment node.
word_value: word_expression -> property_value
delimited_value: delimited_expression -> property_value
               | list_value -> property_value
word_expression: (range_expression | numeric_value | boolean_literal | property_reference | signed_property_reference) -> property_expression
delimited_expression: (string_literal | classifier_term | reference_term | record_value | computed_term) -> property_expression
word_modal_value: word_value -> modal_value
delimited_modal_value: delimited_value -> modal_value
                     | word_value sep in_modes -> modal_value
                     | delimited_value gap in_modes -> modal_value
word_assignment: (modal_value gap "," gap)* word_modal_value -> assignment
delimited_assignment: (modal_value gap "," gap)* delimited_modal_value -> assignment

// Array selection ends with ], so a subsequent in binding needs only gap.
word_path_segment: identifier -> contained_path_segment
delimited_path_segment: identifier array_selection+ -> contained_path_segment
word_contained_path: endpoint_head -> contained_path
                   | endpoint_head array_selection* (gap "." gap contained_path_segment)* gap "." gap word_path_segment -> contained_path
delimited_contained_path: endpoint_head array_selection+ -> contained_path
                        | endpoint_head array_selection* (gap "." gap contained_path_segment)* gap "." gap delimited_path_segment -> contained_path
word_applies_to: /[aA][pP][pP][lL][iI][eE][sS]/ sep /[tT][oO]/ sep (contained_path gap "," gap)* word_contained_path -> applies_to
delimited_applies_to: /[aA][pP][pP][lL][iI][eE][sS]/ sep /[tT][oO]/ sep (contained_path gap "," gap)* delimited_contained_path -> applies_to

word_type_designator: word_list_type -> property_type_designator
                    | word_property_type -> property_type_designator
                    | property_reference -> property_type_designator
delimited_type_designator: delimited_list_type -> property_type_designator
                         | delimited_property_type -> property_type_designator
word_list_type: /[lL][iI][sS][tT]/ sep /[oO][fF]/ sep word_type_designator -> list_type
delimited_list_type: /[lL][iI][sS][tT]/ sep /[oO][fF]/ sep delimited_type_designator -> list_type
word_property_type: /[aA][aA][dD][lL][bB][oO][oO][lL][eE][aA][nN]/ -> property_type
                  | /[aA][aA][dD][lL][sS][tT][rR][iI][nN][gG]/ -> property_type
                  | word_number_type -> property_type
                  | word_range_type -> property_type
                  | word_classifier_type -> property_type
                  | word_reference_type -> property_type
delimited_property_type: enumeration_type -> property_type
                       | units_type -> property_type
                       | delimited_number_type -> property_type
                       | delimited_range_type -> property_type
                       | delimited_classifier_type -> property_type
                       | delimited_reference_type -> property_type
                       | record_type -> property_type
word_number_type: (/[aA][aA][dD][lL][iI][nN][tT][eE][gG][eE][rR]/ | /[aA][aA][dD][lL][rR][eE][aA][lL]/) (sep word_type_range | gap signed_type_range)? (sep /[uU][nN][iI][tT][sS]/ sep property_reference)? -> number_type
delimited_number_type: (/[aA][aA][dD][lL][iI][nN][tT][eE][gG][eE][rR]/ | /[aA][aA][dD][lL][rR][eE][aA][lL]/) (sep word_type_range | gap signed_type_range)? sep /[uU][nN][iI][tT][sS]/ gap units_list -> number_type
word_range_type: /[rR][aA][nN][gG][eE]/ sep /[oO][fF]/ sep (word_number_type | property_reference) -> range_type
delimited_range_type: /[rR][aA][nN][gG][eE]/ sep /[oO][fF]/ sep delimited_number_type -> range_type
word_classifier_type: /[cC][lL][aA][sS][sS][iI][fF][iI][eE][rR]/ -> classifier_type
delimited_classifier_type: /[cC][lL][aA][sS][sS][iI][fF][iI][eE][rR]/ gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")" -> classifier_type
word_reference_type: /[rR][eE][fF][eE][rR][eE][nN][cC][eE]/ -> reference_type
delimited_reference_type: /[rR][eE][fF][eE][rR][eE][nN][cC][eE]/ gap "(" gap metaclass_reference (gap "," gap metaclass_reference)* gap ")" -> reference_type

// Clause 12: mode transitions use indivisible -[ and ]-> delimiters.
type_modes: modes | requires_modes
modes: /[mM][oO][dD][eE][sS]/ sep ((mode | mode_transition)+ | none_statement)
requires_modes: /[rR][eE][qQ][uU][iI][rR][eE][sS]/ sep /[mM][oO][dD][eE][sS]/ sep (mode+ | none_statement)
mode: declaration_name gap ":" gap initial_marker? /[mM][oO][dD][eE]/ inline_properties? gap ";" gap
initial_marker: /[iI][nN][iI][tT][iI][aA][lL]/ sep
mode_transition: (declaration_name gap ":" gap)? mode_reference gap "-[" gap mode_trigger (gap "," gap mode_trigger)* gap "]->" gap mode_reference inline_properties? gap ";" gap
mode_reference: identifier
mode_trigger: endpoint
in_modes: /[iI][nN]/ sep /[mM][oO][dD][eE][sS]/ gap "(" gap mode_reference (gap "," gap mode_reference)* gap ")"
component_in_modes: /[iI][nN]/ sep /[mM][oO][dD][eE][sS]/ gap "(" gap mode_binding (gap "," gap mode_binding)* gap ")"
mode_binding: mode_reference (gap "=>" gap mode_reference)?

// Clause 4.8(7)-(8): accept annex containers; their bodies are deliberately
// opaque. The forbidden internal symbol **} closes the first such container.
annex_library: /[aA][nN][nN][eE][xX]/ sep annex_name annex_body gap ";" gap
// The opaque body ends with a delimiter; none ends with a word and must
// remain separated from a following in modes clause.
annex_subclause: /[aA][nN][nN][eE][xX]/ sep annex_name (opaque_annex_body (gap in_modes)? | empty_annex_body (sep in_modes)?) gap ";" gap
opaque_annex_body: gap ANNEX_TEXT -> annex_body
empty_annex_body: sep /[nN][oO][nN][eE]/ -> annex_body
annex_name: identifier
// The opening annex delimiter needs no separator; the word none still does.
annex_body: gap ANNEX_TEXT | sep /[nN][oO][nN][eE]/

// Clause 15: explicit sep prevents missing word/number boundaries (8Bytes).
// LINE_COMMENT is also a gap alternative: optional units must survive a
// comment followed by a line break, rather than taking a different lexer path.
gap: (WS | LINE_COMMENT | COMMENT)*
sep: (WS | LINE_COMMENT)+
WS: /[ \t\v\f\r\n]+/
LINE_COMMENT: /--[^\v\f\r\n]*[\v\f\r\n]/
COMMENT: /--[^\v\f\r\n]*/
NUMERAL: /[0-9](?:_?[0-9])*/
POSITIVE_EXPONENT: /[Ee]\+?[0-9](?:_?[0-9])*/
EXPONENT: /[Ee][+-]?[0-9](?:_?[0-9])*/
BASED_INTEGER: /[0-9]{1,2}#[0-9A-Fa-f](?:_?[0-9A-Fa-f])*#(?:[Ee]\+?[0-9](?:_?[0-9])*)?/
STRING: /"(?:\"\"|[\u0020-\u0021\u0023-\u007e\u00a0-\ud7ff\ue000-\ufffd])*"/
ANNEX_TEXT: /\{\*\*(?:[^*]|\*[^*]|\*{2,}[^*}])*\*{2,}\}/
// META_WORD permits reserved words in meta-model names such as thread group.
META_WORD: /[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff](?:_?[A-Za-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff0-9])*/
// Portable finite-word exclusion is generated from the clause-15 reserved list;
// unlike lookaround or &/~ this is accepted by both regex implementations.
// Clause 15.7 does not reserve internal; it is contextual in internal features.
IDENT: /(?:(?:[HJ-KQX-Zhj-kqx-z\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[aA](?:[D-KMOQ-Z0-9d-kmoq-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[aA](?:[A-CE-Z0-9a-ce-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[dD](?:[A-KM-Z0-9a-km-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[lL](?:[AC-HJ-QT-Z0-9ac-hj-qt-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[bB](?:[A-NP-Z0-9a-np-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[oO](?:[A-NP-Z0-9a-np-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[oO](?:[A-KM-Z0-9a-km-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[lL](?:[A-DF-Z0-9a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[eE](?:[B-Z0-9b-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[aA](?:[A-MO-Z0-9a-mo-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[nN](?:[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff])))))))|[iI](?:[A-MO-Z0-9a-mo-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[nN](?:[A-SU-Z0-9a-su-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[tT](?:[A-DF-Z0-9a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[eE](?:[A-FH-Z0-9a-fh-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|[gG](?:[A-DF-Z0-9a-df-z0-9\u00c0-\u00d6\u00d8-\u00f6\u00f8-\u00ff]|_[A-Z0-9a-z0-9\u00c0-\u0