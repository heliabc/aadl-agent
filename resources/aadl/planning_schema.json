{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "component_types",
    "implementations"
  ],
  "properties": {
    "component_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "system",
              "process",
              "thread",
              "device",
              "processor",
              "bus",
              "data",
              "memory"
            ]
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "direction",
                "kind",
                "classifier"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "in",
                    "out",
                    "in out"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "data",
                    "event",
                    "event data"
                  ]
                },
                "classifier": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "system",
              "process",
              "thread",
              "device",
              "processor",
              "bus",
              "data",
              "memory"
            ]
          }
        }
      }
    }
  }
}
