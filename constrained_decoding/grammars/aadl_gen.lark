// AADL Generation Grammar (Lark format for Outlines)
// =====================================================
// 生成专用语法：强制内容更丰富（多个组件、多个feature、多个连接等）
// 生成结果在 aadl_core.lark 下完全合法
//
// 注意: 所有规则写在同一行，Lark 不支持缩进式多行规则

start: package_spec

// ---- Package ----
package_spec: "package" WS package_name NEWLINE [with_list] "public" NEWLINE public_decls [private_section] [WS] "end" WS package_name ";" NEWLINE
package_name: IDENT
with_list: with_clause+
with_clause: "with" WS package_name with_rest* ";" NEWLINE
with_rest: "," WS package_name

// 强制至少 3 个声明（2 个组件类型 + 1 个实现）
public_decls: public_decl public_decl public_decl public_decl*
public_decl: component_type | component_impl
private_section: "private" NEWLINE private_decls
private_decls: private_decl*
private_decl: component_type | component_impl

// ---- Component Type ----
component_type: comp_category WS comp_name NEWLINE type_sections [WS] "end" WS comp_name ";" NEWLINE
comp_name: IDENT

// 强制有 features + 至少 2 个 feature
type_sections: WS features_section [WS flows_section] [WS modes_section] [WS properties_section]
comp_category: "system" | "process" | "thread" | "subprogram" | "data" | "device" | "processor" | "memory" | "bus" | "abstract"

// ---- Component Implementation ----
component_impl: comp_category WS comp_name "." impl_name NEWLINE impl_sections [WS] "end" WS comp_name "." impl_name ";" NEWLINE
impl_name: IDENT

// 强制有 subcomponents + connections，且各至少 2 个
impl_sections: WS subcomponents_section WS connections_section [WS flows_impl_section] [WS modes_section] [WS properties_section]

// ---- Features ----
features_section: "features" NEWLINE feature_list
// 至少 2 个 feature
feature_list: feature_decl feature_decl feature_decl*
feature_decl: WS feature_name ":" WS feature_kind ";" NEWLINE
feature_name: IDENT
feature_kind: port_spec | feature_group_spec | access_spec
port_spec: port_dir WS "data port" WS classifier_ref | port_dir WS "event port" | port_dir WS "event data port" WS classifier_ref
port_dir: "in" | "out" | "in out"
feature_group_spec: "feature group" WS classifier_ref
access_spec: access_dir WS access_kind WS classifier_ref
access_dir: "provides" | "requires"
access_kind: "bus access" | "data access" | "subprogram access"

// ---- Subcomponents ----
subcomponents_section: "subcomponents" NEWLINE subcomp_list
// 至少 2 个子组件
subcomp_list: subcomp_decl subcomp_decl subcomp_decl*
subcomp_decl: WS subcomp_name ":" WS comp_category WS classifier_ref [in_modes] ";" NEWLINE
subcomp_name: IDENT
in_modes: WS "in" WS "modes" WS "(" WS mode_name mode_rest* WS ")"
mode_rest: "," WS mode_name
mode_name: IDENT

// ---- Connections ----
connections_section: "connections" NEWLINE conn_list
// 至少 2 个连接
conn_list: conn_decl conn_decl conn_decl*
conn_decl: WS conn_name conn_end WS "->" WS conn_end ";" NEWLINE
conn_name: IDENT ":" WS
conn_end: conn_segment ("." conn_segment)*
conn_segment: IDENT

// ---- Properties ----
properties_section: "properties" NEWLINE prop_list
prop_list: prop_decl+
prop_decl: WS prop_ref WS "=>" WS prop_value ";" NEWLINE
prop_ref: [prop_pkg "::"] prop_name
prop_pkg: IDENT
prop_name: IDENT
prop_value: string_literal | numeric_literal | boolean_literal | classifier_ref

// ---- Modes ----
modes_section: "modes" NEWLINE mode_list
mode_list: mode_decl+
mode_decl: WS mode_name ":" WS [mode_init] "mode" ";" NEWLINE
mode_init: "initial" WS

// ---- Flows (type) ----
flows_section: "flows" NEWLINE flow_spec_list
flow_spec_list: flow_spec_decl+
flow_spec_decl: WS flow_name ":" WS "path flow" WS flow_end WS "->" WS flow_end ";" NEWLINE
flow_name: IDENT
flow_end: IDENT

// ---- Flows (implementation) ----
flows_impl_section: "flows" NEWLINE flow_impl_list
flow_impl_list: flow_impl_decl+
flow_impl_decl: WS flow_name ":" WS flow_kind WS flow_segs ";" NEWLINE
flow_kind: "flow" | "end to end flow"
flow_segs: flow_seg (WS "->" WS flow_seg)*
flow_seg: IDENT ["." IDENT]

// ---- Classifier Reference ----
classifier_ref: [pkg_prefix "::"] classifier_name ["." impl_suffix]
pkg_prefix: IDENT
classifier_name: IDENT
impl_suffix: IDENT

// ---- Terminals ----
IDENT: /[A-Za-z_][A-Za-z0-9_]*/
numeric_literal: /[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?/
string_literal: /"[^"]*"/
boolean_literal: "true" | "false"
WS: /[ \t]+/
NEWLINE: /[\n]+/
